{
  "manifest_version": 3,
  "name": "Kiwi VPN",
  "version": "0.1.0",
  "description": "Private browsing with Kiwi VPN, from Price Chat. One switch sends your browser's traffic through an encrypted connection.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "proxy",
    "storage",
    "webRequest",
    "webRequestAuthProvider",
    "privacy"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kiwi VPN",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
