{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/:page(pokemon|u|website|earn|giveaway|leaderboard|learn|join|content)/:rest*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(TelegramBot|Twitterbot|facebookexternalhit|Facebot|WhatsApp|Slackbot|Slack-ImgProxy|Discordbot|LinkedInBot|SkypeUriPreview|redditbot|Pinterest|vkShare|Embedly|Iframely|Mastodon).*"
        }
      ],
      "destination": "https://api-production-b1be.up.railway.app/api/website/seo/og/:page/:rest*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://api-production-b1be.up.railway.app/api/website/seo/sitemap.xml"
    },
    {
      "source": "/sitemaps/:name",
      "destination": "https://api-production-b1be.up.railway.app/api/website/seo/sitemaps/:name"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.png"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api-production-b1be.up.railway.app/api/:path*"
    },
    {
      "source": "/:page(content|passport|join|leaderboard|giveaway|earn|trading-bot|learn|arena|realm|pokemon|u|website|admin|brain|knowledge|x|approvals|youtube|members|telegram|analytics|activity|settings|api-keys|brand-manager|short-market|invite-bot|affiliate|workers|rank-rewards|trading-os|overview)/:rest*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' https://www.youtube.com https://s.ytimg.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
        }
      ]
    }
  ]
}
