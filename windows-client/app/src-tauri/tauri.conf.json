{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kiwi VPN",
  "mainBinaryName": "KiwiVPN",
  "version": "0.1.0",
  "identifier": "live.pricechat.kiwivpn",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5310",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Kiwi VPN",
        "width": 440,
        "height": 720,
        "minWidth": 400,
        "minHeight": 620,
        "backgroundColor": "#070b09",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost https://ipinfo.io https://ipapi.co; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
