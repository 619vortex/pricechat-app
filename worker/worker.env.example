# Price Chat PC worker settings. Copy to worker/worker.env (git-ignored) and fill in.
# The token is created in Admin > Brand Manager > Settings > AI > Workers and shown once. Never commit worker.env.
PRICECHAT_SERVER=https://api.pricechat.live
PRICECHAT_WORKER_TOKEN=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Short Market: path to the local video model (shared with the Photo to Video Bot, read-only)
PCW_VIDEO_MODEL=
# Gemma thinks by default; 0 turns thinking off so scripts come back as valid JSON
PCW_OLLAMA_THINK=0
