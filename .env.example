# Copy to .env (same folder) and adjust. .env is git-ignored. Never commit secrets.

# --- App ---------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# JSON list of allowed dashboard origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Database ----------------------------------------------------------------
# Default (when unset): SQLite at ./data/price_chat.db. Schema is managed by Alembic
# migrations, which run automatically when the backend starts.
# DATABASE_URL=sqlite:///C:/AI/price-chat/data/price_chat.db
# Later: DATABASE_URL=postgresql+psycopg://user:password@host:5432/price_chat

# --- Model layer -------------------------------------------------------------
# Registered providers: ollama   (future: vortex, dgx_spark, openai, anthropic)
LLM_PROVIDER=ollama
# Default model. Can be overridden per agent from Settings in the dashboard.
LLM_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=120
# Strong-tier background analysis (e.g. gemma3:27b) may need longer, especially while the model loads.
LLM_STRONG_TIMEOUT_SECONDS=300

# Embeddings power meaning-based memory search. Set EMBEDDING_PROVIDER=none for keyword-only search.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# Ollama-specific (only read by the Ollama provider)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# How long Ollama keeps a model in GPU memory after use (avoids slow reloads)
OLLAMA_KEEP_ALIVE=30m

# --- Agent -------------------------------------------------------------------
# Recent chat messages sent with each request
CONVERSATION_WINDOW=20
# Max memories recalled per request, and their size budget in the prompt
MEMORY_RECALL_LIMIT=6
MEMORY_PROMPT_CHAR_BUDGET=4000
# Minimum similarity for a meaning match (calibrated for nomic-embed-text)
RETRIEVAL_MIN_SIMILARITY=0.60

# --- Task → model routing ----------------------------------------------------
# Background AI work is routed by task to a tier. Per-task overrides: Settings › Model routing.
MODEL_TIER_FAST=llama3.1:8b
MODEL_TIER_STRONG=gemma3:27b

# --- Local time ----------------------------------------------------------------
# Zone for "today"/"yesterday" and daily summaries, e.g. Asia/Dubai. Empty = this computer's zone.
TIMEZONE=

# --- Telegram (read-only community intelligence) -----------------------------
# Two modes, both set up on the dashboard (Community › Connection):
#  - Bot: token below or pasted on the dashboard.
#  - Telegram account (official client API): API ID / API Hash from my.telegram.org,
#    then phone + code (+ 2FA) on the dashboard. No .env values; the API Hash and the
#    session are stored encrypted (DPAPI) and never shown again.
# Bot token from @BotFather. Easiest: paste it on the dashboard (Community › Setup & chats);
# it is then stored encrypted on this computer and takes priority over this value.
# SECRET: never commit or share it. Chats are authorised in the dashboard, not here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_LONG_POLL_SECONDS=10

# --- Background jobs (seconds between runs) ----------------------------------
SCHEDULER_ENABLED=true
JOB_TELEGRAM_INGEST_SECONDS=20
JOB_COMMUNITY_PROCESS_SECONDS=60
JOB_COMMUNITY_TOPICS_SECONDS=300
JOB_SUMMARY_RECENT_SECONDS=10800
JOB_SUMMARY_DAILY_SECONDS=3600
JOB_MEMORY_EXTRACTION_SECONDS=1800
JOB_OPPORTUNITIES_SECONDS=3600
JOB_KNOWLEDGE_REINDEX_SECONDS=1800

# --- Community intelligence tuning (calibrated for nomic-embed-text) ---------
COMMUNITY_TOPIC_SIMILARITY=0.75
COMMUNITY_QUESTION_SIMILARITY=0.80
COMMUNITY_TOPIC_MIN_MESSAGES=3
COMMUNITY_TOPIC_MIN_PARTICIPANTS=2
COMMUNITY_RECURRING_MIN_ASKS=2
COMMUNITY_SUMMARY_MIN_MESSAGES=8

# --- X / Twitter (read-only, official X API v2) -------------------------------
# Easiest: paste keys on the dashboard (X › Connection). They are then stored encrypted
# (Windows DPAPI) in data\secrets.dpapi and take priority over anything here.
# Only set them here if you prefer .env. SECRETS: never commit or share them.
# X_BEARER_TOKEN=          # enough for public monitoring (search, watchlist, mentions by username)
# X_API_KEY=               # optional account keys (all four together):
# X_API_SECRET=            #   your own posts, private metrics (impressions/clicks)
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
# X_ACCOUNT_USERNAME=      # your account, e.g. pricechat (also settable on the dashboard)
X_API_BASE=https://api.x.com
# X charges per request (pay-per-use). Price Chat stops reading when a budget is reached.
# Local estimate per X write request (post/reply/like/repost/follow); X does not report it per request.
X_WRITE_COST_ESTIMATE_USD=0.01
X_DAILY_BUDGET_USD=1.0
X_MONTHLY_BUDGET_USD=20.0

# --- Phase 3B/4A background jobs (seconds between runs) -----------------------
JOB_X_INGEST_SECONDS=900
JOB_X_OPPORTUNITIES_SECONDS=1800
JOB_CROSS_SIGNALS_SECONDS=900
JOB_TOPIC_MERGE_SECONDS=3600
JOB_OPPORTUNITY_RANK_SECONDS=1800
JOB_APPROVALS_EXPIRE_SECONDS=600

# Encrypted store for secrets entered on the dashboard (default: data\secrets.dpapi).
# SECRETS_FILE=

# --- YouTube (read-only, official Data API v3) ---------------------------------
# Usually entered on the dashboard (YouTube page) and stored encrypted instead.
# YOUTUBE_API_KEY=
# Optional Google sign-in: client from Google Cloud (Web application) with this redirect URI registered.
# YOUTUBE_REDIRECT_URI=http://127.0.0.1:8000/api/youtube/oauth/callback
# DASHBOARD_URL=http://127.0.0.1:5173/admin
# How often new uploads are picked up (seconds).
JOB_YOUTUBE_SYNC_SECONDS=900


# --- Production (Railway). Locally all of these can stay unset. ---------------------------------------------------
# In production the backend refuses to start unless these are set explicitly (https, not localhost):
# ENVIRONMENT=production
# DATABASE_URL=sqlite:////data/price_chat.db
# MEMBERS_PUBLIC_URL=https://your-domain
# DASHBOARD_URL=https://your-domain/admin
# CORS_ORIGINS=["https://your-domain"]
# Owner login for /admin and every admin API. Paste the HASH, never the password:
#   cd backend && .venv\Scripts\python -m app.security.admin_auth hash
# Setting ADMIN_PASSWORD_HASH locally turns the login on in development too.
# ADMIN_USERNAME=
# ADMIN_PASSWORD_HASH=
# ADMIN_SESSION_HOURS=12
# Encrypts stored connector secrets without Windows DPAPI (required in production). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# APP_ENCRYPTION_KEY=
# Rate limits key on the real visitor (app/security/client_ip.py). Set the SAME long random value here (Railway) and in
# the Vercel project's env (Production), then redeploy both. Vercel's /api rewrite sends it as x-pc-edge; only then is
# Vercel's visitor address believed. Unset: callers are keyed on the address Railway's edge saw (Vercel's egress for
# website traffic). Generate: python -c "import secrets; print(secrets.token_hex(32))"; old,new while rotating.
# PROXY_SHARED_SECRET=
# How many right-most X-Forwarded-For entries our own proxies append (Railway's edge: 1).
# TRUSTED_PROXY_HOPS=1
# Comma-separated job ids this server must never run (e.g. so only one server reads Telegram):
# SCHEDULER_DISABLED_JOBS=telegram.ingest,x.ingest,x.opportunities,combot.sync
