<?xml version="1.0" encoding="utf-8"?>
<!-- TLS only, trusting only the system's certificates: a user-added certificate can't read the app's traffic. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
